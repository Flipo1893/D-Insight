# Create a form at https://formspree.io, then copy this file to .env.local
# and paste your form ID below (the part after /f/ in your endpoint URL).
NEXT_PUBLIC_FORMSPREE_ID=your_formspree_id

# Create a free cluster at https://mongodb.com/cloud/atlas, then copy the
# connection string (Database -> Connect -> Drivers). Speichert die geteilten
# Schnellcheck-Berichte unter /check/<id>. Leer heisst: der Check laeuft
# weiter, nur das Teilen per Link faellt weg.
# No NEXT_PUBLIC_ prefix: this is server-only and must never reach the browser.
MONGODB_URI=your_mongodb_connection_string
MONGODB_DB=d-insight

# --- Google Analytics -------------------------------------------------------
# Mess-ID, z.B. G-XXXXXXXXXX. Leer lassen heisst: keine Cookies, kein Banner,
# keine Uebertragung in die USA.
NEXT_PUBLIC_GA_ID=

# --- KI-Einschaetzung im Schnellcheck ---------------------------------------
# Zusaetzliche Bewertung neben den gemessenen Punkten: sagt der Titel etwas,
# ist das Angebot verstaendlich, taugen die Bildtexte. Leer heisst: der
# Abschnitt erscheint nicht, alles andere am Check bleibt unveraendert.
#
# Alles hier spricht das OpenAI-Format. Der Wechsel von lokal auf einen
# Anbieter ist deshalb nur ein Wechsel dieser drei Zeilen, kein Code.
#
# Lokal mit Ollama (https://ollama.com, danach `ollama pull llama3.2`):
#   AI_CHECK_BASE_URL=http://localhost:11434/v1
#   AI_CHECK_MODEL=llama3.2
#
# Spaeter auf dem Server bei einem Anbieter: Basis-URL und Modell ersetzen
# und den Schluessel setzen. Server-only, kein NEXT_PUBLIC_.
#
#   AI_CHECK_BASE_URL=https://api.openai.com/v1
#   AI_CHECK_MODEL=gpt-4o-mini
#   AI_CHECK_API_KEY=sk-...
#
# Beim Hosting gehoeren diese drei in die Umgebungsvariablen des Projekts,
# nicht in eine Datei im Repo. Bei Vercel: Project Settings -> Environment
# Variables.
AI_CHECK_BASE_URL=
AI_CHECK_MODEL=llama3.2
AI_CHECK_API_KEY=

# Wie lange eine einzelne Frage dauern darf, in Millisekunden. Standard
# 20000, ausgelegt auf einen Anbieter ueber das Netz. Nur noetig, wenn ein
# langsames lokales Modell laeuft: llama3.2 auf einer CPU brauchte im Test
# 40 bis 119 Sekunden fuer alle vier Fragen zusammen.
# AI_CHECK_TIMEOUT_MS=60000
