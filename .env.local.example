# Copy this file to .env.local and fill in the values you have.
# Every block is optional: the app degrades gracefully when a service is
# missing rather than crashing, so you can wire them up one at a time.

# --- Contact form -----------------------------------------------------------
# Create a form at https://formspree.io and paste the ID here (the part after
# /f/ in the endpoint URL). Without it the contact section shows a mail link.
NEXT_PUBLIC_FORMSPREE_ID=

# --- Customer login (Supabase) ---------------------------------------------
# Project settings -> API in the Supabase dashboard.
# Without these, /login and /dashboard explain that they are not set up yet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute URL of this deployment. Used to build the confirmation link that
# Supabase mails out, so it has to match where the site actually runs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Customer content (MongoDB) --------------------------------------------
# Connection string from MongoDB Atlas. Without it the content editor shows
# example text and saving stays disabled.
MONGODB_URI=
MONGODB_DB=d-insight
