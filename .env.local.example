# Create a form at https://formspree.io, then copy this file to .env.local
# and paste your form ID below (the part after /f/ in your endpoint URL).
NEXT_PUBLIC_FORMSPREE_ID=your_formspree_id

# Create a project at https://supabase.com, then copy both values from
# Project Settings -> API. That's it — login, signup, logout and the
# /dashboard route all activate automatically once these are set.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Used to build the email-confirmation redirect link Supabase sends on
# sign-up. Set this to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Create a free cluster at https://mongodb.com/cloud/atlas, then copy the
# connection string (Database -> Connect -> Drivers). Powers the "Inhalte
# bearbeiten" dashboard tab — saving/loading a customer's website content.
# No NEXT_PUBLIC_ prefix: this is server-only and must never reach the browser.
MONGODB_URI=your_mongodb_connection_string
MONGODB_DB=d-insight

# Wer den "Kunden"-Tab im Dashboard sieht und Kundenwebsites konfigurieren
# darf — kommagetrennte E-Mail-Adressen. Server-only, kein NEXT_PUBLIC_.
ADMIN_EMAILS=dominic@example.com,beg@example.com

# --- Google Analytics -------------------------------------------------------
# Mess-ID, z.B. G-XXXXXXXXXX. Leer lassen heisst: keine Cookies, kein Banner,
# keine Uebertragung in die USA. Die eigene cookiefreie Zaehlung laeuft
# unabhaengig davon weiter und braucht keine Einwilligung.
NEXT_PUBLIC_GA_ID=

# --- Monitoring -------------------------------------------------------------
# Gemeinsames Geheimnis fuer den geplanten Lauf unter /api/monitor/run.
# Leer heisst: der Endpunkt antwortet allen mit 404, auch dem Scheduler.
MONITOR_SECRET=

# --- Stripe (Abo fuer den Kundenbereich) ------------------------------------
# Aus dem Stripe-Dashboard: Developers -> API keys (Secret key) und
# Product catalog -> das monatliche Produkt -> Preis-ID (beginnt mit price_).
# Server-only, kein NEXT_PUBLIC_ — der Secret Key darf nie in den Browser.
# Leer heisst: keine Bezahlschranke, der Kundenbereich ist fuer alle offen.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Signaturgeheimnis des Webhooks (Developers -> Webhooks -> Endpunkt anlegen
# auf https://<domain>/api/stripe/webhook, Ereignisse: checkout.session.completed
# und customer.subscription.*). Lokal liefert `stripe listen` ein eigenes.
STRIPE_WEBHOOK_SECRET=

# --- KI-Einschaetzung im Schnellcheck ---------------------------------------
# Zusaetzliche Bewertung neben den gemessenen Punkten: sagt der Titel etwas,
# ist das Angebot verstaendlich, taugen die Bildtexte. Leer heisst: der
# Abschnitt erscheint nicht, alles andere am Check bleibt unveraendert.
#
# Alles hier spricht das OpenAI-Format. Der Wechsel von lokal auf einen
# Anbieter ist deshalb nur ein Wechsel dieser drei Zeilen, kein Code.
#
# Lokal mit Ollama (https://ollama.com, danach `ollama pull llama3.2`):
#   AI_CHECK_BASE_URL=http://localhost:11434/v1
#   AI_CHECK_MODEL=llama3.2
#
# Spaeter auf dem Server bei einem Anbieter: Basis-URL und Modell ersetzen
# und den Schluessel setzen. Server-only, kein NEXT_PUBLIC_.
AI_CHECK_BASE_URL=
AI_CHECK_MODEL=llama3.2
AI_CHECK_API_KEY=
